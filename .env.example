# YNAB Helper (v2) configuration
#
# Docker: save this file as `bot.env` next to docker-compose.yml (chmod 600). It is mounted
#         read-only at /app/.env.
# CLI:    copy it to `.env` in the repository root.
#
# Format: KEY=VALUE, one per line. Quotes are optional, and ` # comment` after an unquoted
# value is ignored. Variables already set in the environment win over this file.
# An empty value means "not set", except for LOG_FILE, where empty disables the log file.
# Never commit the filled-in file.

# ─── Telegram bot (required for the bot) ────────────────────────────────────
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). This user is the admin.
TELEGRAM_ADMIN_ID=

# ─── YNAB ───────────────────────────────────────────────────────────────────
# Required for the CLI. For the bot, these are optional: when all three are set, the admin
# is registered from them at startup (only while the admin has no working setup). Every
# other bot user enters their own token in chat (/setup).
# Personal access token: app.ynab.com → Account Settings → Developer Settings.
YNAB_TOKEN=
# Find the ids with: python3 revolut_to_ynab.py --list-budgets / --list-accounts
YNAB_BUDGET_ID=
# The YNAB account your Revolut statements are imported into.
YNAB_ACCOUNT_ID=

# ─── Web UI (optional) ──────────────────────────────────────────────────────
# 1 starts the web dashboard inside the bot process. Users sign in with /login in the bot.
WEB_UI_ENABLED=0
# Required when enabled: the public https:// address in front of the container (your
# reverse proxy, e.g. Caddy). No query or fragment; a trailing slash is removed.
WEB_UI_PUBLIC_URL=
# Required when enabled: at least 32 characters. It keys the HMACs of sign-in tokens,
# sessions and CSRF tokens; changing it signs everyone out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_UI_SECRET_KEY=
# Bind address and port inside the container. Do not publish the port on the host; the
# reverse proxy reaches it over the compose network.
# WEB_UI_HOST=0.0.0.0
# WEB_UI_PORT=8080
# Lifetimes in seconds: sign-in button, idle session (sliding) and absolute session limit.
# WEB_UI_LOGIN_TTL=300
# WEB_UI_SESSION_TTL=1800
# WEB_UI_SESSION_ABS_TTL=43200
# Optional IP allowlist: IPs or networks separated by commas or spaces. Empty means anyone
# who can reach the proxy. One invalid entry keeps the web UI off (fails closed).
# WEB_UI_ALLOWED_IPS=203.0.113.7, 192.168.1.0/24
# Proxies whose X-Forwarded-For header is trusted (IPs or networks, comma-separated).
# `*` trusts any client that reaches port 8080 directly. If the compose network is shared
# with other containers, any of them can spoof X-Forwarded-For: harmless without an
# allowlist (only the /auth rate-limit key and logged IPs), but it bypasses
# WEB_UI_ALLOWED_IPS. With an allowlist, set the reverse proxy's IP here instead.
# WEB_UI_TRUSTED_PROXIES=*

# ─── Crypto portfolio sync (optional: /crypto, --crypto-sync) ───────────────
# Bot users configure these with /crypto_setup. Here they are CLI defaults and the
# admin's auto-registration values.
# YNAB tracking account that holds the portfolio value (budget currency must be CHF).
YNAB_CRYPTO_ACCOUNT_ID=
# xpub, ypub or zpub (e.g. Ledger Live → account → Advanced), or a single BTC address.
# Read-only, but it reveals every address and balance of the wallet: keep it private.
CRYPTO_BTC_XPUB=
# Ethereum address: native ETH plus AAVE, USDC, USDT and aUSDT.
CRYPTO_ETH_ADDRESS=
# Optional Ankr API key: an authenticated RPC tried before the public endpoints.
ANKR_API_KEY=

# ─── Interactive Brokers NAV sync (optional, CLI --brokerage-sync) ──────────
# YNAB tracking account for the IBKR net asset value (budget currency must be CHF).
YNAB_BROKERAGE_ACCOUNT_ID=
# IB Client Portal Gateway. TLS is verified except for localhost/127.0.0.1/::1.
# IBKR_BASE_URL=https://localhost:5050
# IB account id such as U1234567. Default: the first account the gateway lists.
# IBKR_ACCOUNT_ID=

# ─── Logging ────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR or CRITICAL. One audit line per YNAB write is logged at INFO
# regardless of this level.
LOG_LEVEL=INFO
# Rotating log file (5 MB × 5), also what the bot's /logs command sends. Docker: keep this
# path so the host-side log is bot_data/bot.log as in v1 (the default would land in
# bot_data/.revolut_to_ynab.log). CLI on your machine: remove the line to log to
# ~/.revolut_to_ynab.log. An empty value disables the log file and /logs.
LOG_FILE=/app/bot_data/bot.log

# ─── CLI ────────────────────────────────────────────────────────────────────
# Folder where the CLI looks for the newest Revolut statement when no file is given.
# CSV_DIR=~/Downloads

# ─── Advanced (leave unset unless you know you need them) ───────────────────
# Data directory (databases, statements, backups). The image uses /app/bot_data.
# BOT_DATA_DIR=./bot_data
# The unprivileged user the container switches to after preparing bot_data.
# APP_UID=10001
# APP_GID=10001
# Health check: maximum age of the bot's heartbeat file, in seconds.
# HEALTHCHECK_MAX_AGE=180
# Tests and local smoke runs only; never set this in production.
# TELEGRAM_API_BASE=https://api.telegram.org
# Not here: set TZ (e.g. Europe/Zurich) in docker-compose.yml. BUILD_SHA and BUILD_DATE are
# set by the image build.
