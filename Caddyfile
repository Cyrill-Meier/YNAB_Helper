# Caddy reverse proxy + automatic Let's Encrypt for the Revolut → YNAB
# bot's web UI. Reference config for NEW installs; an existing server keeps
# its own Caddyfile.
#
# IMPORTANT: replace `bot.example.com` below with your real hostname
# before deploying. Caddy uses it both as the SNI / vhost match and as
# the ACME identifier for the Let's Encrypt cert request.
#
# ──────────────────────────────────────────────────────────────────────
# (Optional) Global options.
# Uncomment `email` and put your address — Let's Encrypt sends expiry
# warnings there if cert renewal ever fails.
# ──────────────────────────────────────────────────────────────────────
{
	# email you@example.com
	# acme_ca https://acme-v02.api.letsencrypt.org/directory   # default
	# Uncomment for staging when iterating on Caddyfile changes:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

bot.example.com {
	# Reject oversized request bodies at the edge. The largest legitimate
	# body is a CSV upload (raw body of POST /api/upload), which the app
	# caps at 26 MB itself. This limit is at least as large as the app's
	# (MiB, not MB), so it never rejects a body the app would accept, while
	# anything bigger is cut off before it reaches the container.
	request_body {
		max_size 26MiB
	}

	# Reverse proxy to the bot's web UI on the internal docker network.
	# The bot listens on 8080 inside its container; the service name
	# `revolut-ynab-bot` resolves via Docker's DNS.
	reverse_proxy revolut-ynab-bot:8080

	# Security headers the app does not send itself.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), usb=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=()"
		# Don't leak the proxy stack (cosmetic, not security).
		-Server
		-Via
	}

	# The app sends its own strict Content-Security-Policy (`'self'` only:
	# no inline scripts or styles and no CDN — the Tailwind CSS is built
	# ahead of time and served from /static), plus X-Content-Type-Options,
	# Referrer-Policy and X-Frame-Options. The `?` prefix makes Caddy add
	# each of them only when a proxied response does not already carry it,
	# so the app's values are never overridden; the strict defaults below
	# only act as a safety net. One directive per header on purpose: inside
	# a single `header { }` block Caddy only fills the defaults when ALL of
	# them are missing.
	#
	# Do not set the CSP with a plain `Content-Security-Policy "…"` line in
	# a block that also deletes headers (`-Server`): such a block is applied
	# when the response is written and REPLACES the app's policy (verified
	# with Caddy 2.11) instead of adding a second one that browsers would
	# combine with it. The old reference config did exactly that.
	header ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "same-origin"
	header ?X-Frame-Options "DENY"

	# Compact log line per request — easy to grep in
	# `docker compose logs caddy`. Comment out if you want zero access
	# logs (Caddy's defaults are fine too).
	log {
		output stdout
		format console
	}
}
